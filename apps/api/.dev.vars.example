# Copiar a .dev.vars y rellenar. NUNCA commitear .dev.vars.

# ID de cuenta Cloudflare (dashboard -> overview)
R2_ACCOUNT_ID=

# Token de API de R2 con "Object Read & Write" sobre photos-media y photos-media-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Secreto de sesiones: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL base pública de la API. En `wrangler dev` sobrescribe al var de
# wrangler.jsonc (que lleva la URL de producción).
BETTER_AUTH_URL=http://localhost:8787

# Orígenes web permitidos por CORS, separados por coma. En `wrangler dev`
# sobrescribe al var de wrangler.jsonc (que lleva el origen de producción).
WEB_ORIGINS=http://localhost:8081

# Email admin del panel /v1/admin/storage. En prod va en wrangler.jsonc vars.
ADMIN_EMAIL=luis.sg9915@gmail.com

# Correo transaccional (recuperación de contraseña) vía Resend.
# Sin clave, el "envío" se escribe en el log de wrangler: copia el enlace de ahí.
# En producción: `npx wrangler secret put RESEND_API_KEY` (nunca en vars).
RESEND_API_KEY=
# Remitente. onboarding@resend.dev solo envía al email dueño de la cuenta Resend;
# para producción hace falta un dominio verificado en Resend y ponerlo aquí
# (dev) o como var EMAIL_FROM en wrangler.jsonc (prod).
EMAIL_FROM=Photos <onboarding@resend.dev>
