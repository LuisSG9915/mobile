{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "photos-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photos-db",
      "database_id": "475daf1d-32bf-4b07-860f-3e0f544f00a9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "photos-media",
      "preview_bucket_name": "photos-media-dev",
      // En `wrangler dev` el binding va contra el bucket real (photos-media-dev):
      // las URLs prefirmadas ya suben al R2 real, así /complete puede verificar.
      "remote": true
    }
  ],
  // Estos vars son los valores de PRODUCCIÓN del worker desplegado.
  // En `wrangler dev` los sobrescribe apps/api/.dev.vars (localhost).
  "vars": {
    "R2_ACCOUNT_ID": "461d52ab67ae2435c8dde9a0887f27cb",
    "R2_BUCKET_NAME": "photos-media",
    "PRESIGN_TTL_SECONDS": "900",
    "MAX_ORIGINAL_BYTES": "5368709120",
    "BETTER_AUTH_URL": "https://photos-api.luis-sg9915.workers.dev",
    "WEB_ORIGINS": "https://photos-web.luis-sg9915.workers.dev",
    "ADMIN_EMAIL": "luis.sg9915@gmail.com"
    // Recuperación de contraseña (Resend):
    // - RESEND_API_KEY va como SECRET: `npx wrangler secret put RESEND_API_KEY`.
    // - EMAIL_FROM cuando haya dominio verificado en Resend, ej.:
    //   "EMAIL_FROM": "Photos <no-reply@tudominio.com>"
    // Sin RESEND_API_KEY el enlace de reset solo se escribe en los logs.
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      // Freno de fuerza bruta sobre login/registro, por IP (middleware en index.ts).
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
