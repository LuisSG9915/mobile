# URL base de la API desplegada en Cloudflare Workers.
EXPO_PUBLIC_API_URL=https://photos-api.luis-sg9915.workers.dev

# Email del administrador para acceso al panel de administración (opcional)
EXPO_PUBLIC_ADMIN_EMAIL=admin@ejemplo.com

# En desarrollo local con dispositivo físico usa la IP LAN del PC, ej:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8787
# En emulador Android también funciona: adb reverse tcp:8787 tcp:8787
