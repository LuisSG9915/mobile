{
  "name": "photos-platform",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @photos/api dev",
    "dev:mobile": "pnpm --filter @photos/mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:pipeline": "node --test scripts/test-pipeline.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:report": "node scripts/test-report.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
